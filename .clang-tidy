Checks: >
  bugprone-*,
  performance-*,
  readability-*,
  modernize-*,
  misc-*,
  portability-*,
  concurrency-*,
  clang-analyzer-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements

WarningsAsErrors: ''

HeaderFilterRegex: '^(?!.*(lib/tinyusb|pico-sdk)).*'

FormatStyle: file
